# ===========================================================================
# Environment Configuration for Face Recognition API
# ===========================================================================

# API Authentication Bearer Token (Required)
# Generate a secure token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-with-generate-token

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Default Models (Hugging Face model ID / relative path)
DET_MODEL_PATH=face_detection/scrfd_2.5g_bnkps.onnx
REC_MODEL_PATH=face_recognition/arcface_r50_fp16.onnx

# Detection & Matching Thresholds
CONF_THRESHOLD=0.50
IOU_THRESHOLD=0.40
SIM_THRESHOLD=0.45
